{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/calculator", "destination": "/calculator.html" },
    { "source": "/late-payment-letter-template", "destination": "/late-payment-letter-template.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/guides/late-payment-act-1998-explained", "destination": "/guides-late-payment-act-1998-explained.html" },
    { "source": "/guides/how-to-chase-late-invoices", "destination": "/guides-how-to-chase-late-invoices.html" },
    { "source": "/guides/client-not-paying-invoice", "destination": "/guides-client-not-paying-invoice.html" },
    { "source": "/guides/letter-before-action", "destination": "/guides-letter-before-action.html" },
    { "source": "/guides/small-claims-court-unpaid-invoice", "destination": "/guides-small-claims-court-unpaid-invoice.html" },
    { "source": "/guides/how-much-interest-late-invoice", "destination": "/guides-how-much-interest-late-invoice.html" },
    { "source": "/guides/invoice-payment-terms-uk", "destination": "/guides-invoice-payment-terms-uk.html" },
    { "source": "/guides/freelancer-rights-late-payment", "destination": "/guides-freelancer-rights-late-payment.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/((?!sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/auto-chase",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/social-post",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/social-post?mode=engage",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/social-post?mode=engage",
      "schedule": "0 15 * * *"
    }
  ]
}
